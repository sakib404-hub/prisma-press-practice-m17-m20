model Post {
  id         String     @id @default(uuid())
  title      String     @db.Text
  content    String     @db.Text
  thumbnail  String     @db.Text
  isFeatured Boolean    @default(false)
  status     PostStatus @default(PUBLISHED)
  tags       String[]
  views      Int        @default(0)

  //? addingg isPremium for subscribed users and post
  isPremium Boolean @default(false)

  //? adding the created at and the updated at field
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //? creating  relationship with the author or the user and the comment
  author   User   @relation(fields: [authorId], references: [id])
  authorId String

  //? here there will be a connection with the comments
  comment Comment[]

  //? using block level for renaming and indexing
  @@index([authorId])
  @@map("posts")
}
